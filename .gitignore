data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Runtime caches written by the app
data/cache/

# Seller uploads are user generated
src/uploads/*
!src/uploads/.gitkeep

# Editors and operating systems
.idea/
.vscode/
.DS_Store
*.swp

# Tooling
node_modules/
vendor/
*.log
